{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Offbeat",
  "version": "0.1.0",
  "identifier": "dev.matheusinfo.offbeat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && npm run licenses",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Offbeat",
        "width": 560,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://i.ytimg.com data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Music",
    "shortDescription": "Download YouTube audio as small files for your watch",
    "longDescription": "Paste a YouTube link, get a small audio file with tags and cover, ready for your watch.",
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg", "binaries/ffprobe", "binaries/deno"],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE",
      "binaries/THIRD-PARTY-LICENSES.txt": "licenses/THIRD-PARTY-LICENSES.txt",
      "binaries/YT-DLP-LICENSE.txt": "licenses/YT-DLP-LICENSE.txt",
      "binaries/YT-DLP-THIRD-PARTY-LICENSES.txt": "licenses/YT-DLP-THIRD-PARTY-LICENSES.txt",
      "binaries/FFMPEG-LICENSE.txt": "licenses/FFMPEG-LICENSE.txt",
      "binaries/FFMPEG-SOURCE.txt": "licenses/FFMPEG-SOURCE.txt",
      "binaries/DENO-LICENSE.md": "licenses/DENO-LICENSE.md"
    },
    "copyright": "© 2026 Matheus Andrade. YouTube is a trademark of Google LLC; Offbeat is not affiliated with Google.",
    "license": "MIT"
  }
}
